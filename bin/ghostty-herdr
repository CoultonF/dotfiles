#!/usr/bin/env bash
# ghostty-herdr: open a Ghostty window running herdr instead of tmux.
#
# The normal Ghostty window starts a login shell, and ~/.zshrc auto-attaches
# tmux there (see home.nix). This launcher skips the login shell entirely and
# makes herdr the window's command, so the two multiplexers never fight over
# the same window.
#
# Any extra arguments are passed straight to herdr, e.g.
#   ghostty-herdr --session scratch
set -euo pipefail

HERDR_BIN="${HERDR_BIN:-$HOME/.local/bin/herdr}"
SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"

if [[ ! -x "$HERDR_BIN" ]]; then
	if command -v herdr >/dev/null 2>&1; then
		HERDR_BIN="$(command -v herdr)"
	else
		echo "ghostty-herdr: herdr not found (looked at $HERDR_BIN and \$PATH)" >&2
		echo "Install it from https://herdr.dev, or set HERDR_BIN to its path." >&2
		exit 1
	fi
fi

if [[ ! -d /Applications/Ghostty.app ]]; then
	echo "ghostty-herdr: /Applications/Ghostty.app not found" >&2
	exit 1
fi

# macOS throws away --args when it just activates an already-running app, so
# -n is required: it starts a fresh Ghostty instance that honours -e. That
# instance quits again when its last window closes. `-e` must come last --
# Ghostty treats everything after it as the command line to run.
exec open -na Ghostty --args \
	--window-width=200 \
	--window-height=50 \
	-e /usr/bin/env PATH="$SCRIPT_DIR/herdr-ssh:$PATH" "$HERDR_BIN" "$@"
