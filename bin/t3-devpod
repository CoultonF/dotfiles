#!/usr/bin/env bash
# t3-devpod: run a T3 Code server inside a devpod, published on the tailnet.
#
#   t3-devpod start   Start `t3 serve` behind Tailscale Serve if it isn't running.
#                     Silent no-op off Linux or without a connected tailscaled,
#                     so shell startup can call it unconditionally.
#   t3-devpod pair [LABEL] [--label LABEL] [--ttl 15m]
#                     Start if needed, then mint a pairing code and link (prints the
#                     t3code:// app link). The Mac's `t3-pair` runs this over SSH.
#   t3-devpod stop    Stop the server.
#   t3-devpod status  Show whether the server is running and where.
#
# Tailscale Serve publishes HTTPS port $T3_DEVPOD_SERVE_PORT (default 8443) to
# the local server on $T3_DEVPOD_LOCAL_PORT (default 3773), leaving 443 for
# project services that already claim it. The tailnet policy must allow
# that port to this node.
set -euo pipefail

SERVE_PORT="${T3_DEVPOD_SERVE_PORT:-8443}"
LOCAL_PORT="${T3_DEVPOD_LOCAL_PORT:-3773}"

# Keep T3's data (auth sessions, threads) on the workspace volume, which survives
# devpod rebuilds while the container's home does not. With the tailnet identity
# also kept there, paired phones and desktops stay paired across rebuilds. The
# directory is hidden from git via the clone's local exclude file, never the repo.
persistent_home() {
	[ -n "${T3_DEVPOD_HOME:-}" ] && { echo "$T3_DEVPOD_HOME"; return; }
	local git_dir
	git_dir="$(git -C /workspace rev-parse --git-common-dir 2>/dev/null)" || { echo "$HOME/.t3"; return; }
	case "$git_dir" in /*) ;; *) git_dir="/workspace/$git_dir" ;; esac
	mkdir -p "$git_dir/info"
	grep -qxF '/.t3-home/' "$git_dir/info/exclude" 2>/dev/null || echo '/.t3-home/' >>"$git_dir/info/exclude"
	echo /workspace/.t3-home
}
export T3CODE_HOME="${T3CODE_HOME:-$(persistent_home)}"
STATE_DIR="$T3CODE_HOME/devpod"
PID_FILE="$STATE_DIR/serve.pid"
LOG_FILE="$STATE_DIR/serve.log"
export PATH="$HOME/.bun/bin:$HOME/.nix-profile/bin:/nix/var/nix/profiles/default/bin:$PATH"

# The pid file survives a devpod restart, so check the pid still belongs to t3.
running() {
	local pid
	pid="$(cat "$PID_FILE" 2>/dev/null)" || return 1
	[ -n "$pid" ] && kill -0 "$pid" 2>/dev/null &&
		tr '\0' ' ' <"/proc/$pid/cmdline" 2>/dev/null | grep -q 't3.*serve'
}

tailnet_up() {
	command -v tailscale >/dev/null 2>&1 &&
		tailscale status --json 2>/dev/null | grep -q '"BackendState": *"Running"'
}

# Publish with Tailscale Serve ourselves rather than through t3's
# --tailscale-serve, falling back to sudo when tailscaled runs as root. Never set
# an operator to avoid sudo: that is a saved pref, and a later `tailscale up`
# that doesn't repeat --operator then refuses to run, breaking tailnet startup.
publish() {
	local args=(serve --bg --https="$SERVE_PORT" "http://127.0.0.1:$LOCAL_PORT")
	tailscale "${args[@]}" >/dev/null 2>&1 || sudo -n tailscale "${args[@]}" >/dev/null 2>&1
}

tailnet_name() {
	tailscale status --json | jq -r '.Self.DNSName | rtrimstr(".")'
}

start() {
	[ "$(uname -s)" = Linux ] || return 0
	running && return 0
	command -v t3 >/dev/null 2>&1 || return 0
	tailnet_up || return 0
	publish || {
		echo "t3-devpod: cannot configure Tailscale Serve (needs passwordless sudo)" >&2
		return 1
	}

	local workdir="${T3_DEVPOD_CWD:-}"
	if [ -z "$workdir" ]; then
		if [ -d /workspace ]; then workdir=/workspace; else workdir="$HOME"; fi
	fi

	mkdir -p "$STATE_DIR"
	"$(dirname "${BASH_SOURCE[0]}")/t3-defaults" >>"$LOG_FILE" 2>&1 || true
	setsid nohup t3 serve --no-browser --port "$LOCAL_PORT" \
		--auto-bootstrap-project-from-cwd "$workdir" \
		>>"$LOG_FILE" 2>&1 </dev/null &
	echo $! >"$PID_FILE"
}

case "${1:-start}" in
start)
	start
	;;
pair)
	shift
	label="$(hostname)"
	ttl=15m
	while [ $# -gt 0 ]; do
		case "$1" in
		--label=*) label="${1#*=}" ;;
		--label) label="${2:?--label needs a value}"; shift ;;
		--ttl=*) ttl="${1#*=}" ;;
		--ttl) ttl="${2:?--ttl needs a value}"; shift ;;
		-*) echo "usage: t3-devpod pair [LABEL] [--label LABEL] [--ttl 15m]" >&2; exit 2 ;;
		*) label="$1" ;;
		esac
		shift
	done
	tailnet_up || { echo "t3-devpod: tailscale is not connected on $(hostname)" >&2; exit 1; }
	start
	# `t3 pair` fails with NoRunningServerError until the server has written
	# its runtime file, so retry while a fresh server boots. Its URLs point at
	# localhost (its --tailscale would re-run Serve without sudo), so rebuild
	# them from the token and this node's tailnet name. The token is printed on
	# its own line for clients that ask for a pairing code.
	for _ in $(seq 1 60); do
		if out="$(t3 pair --label "$label" --ttl "$ttl" 2>&1)"; then
			token="$(printf '%s\n' "$out" | sed -n 's/^Token: *//p' | head -1)"
			url="https://$(tailnet_name):$SERVE_PORT/pair#token=$token"
			echo "Token: $token"
			echo "Pairing URL: $url"
			echo "App link: t3code://pair?pairingUrl=$(jq -rn --arg u "$url" '$u|@uri')"
			printf '%s\n' "$out" | grep -E '^Expires' || true
			if command -v qrencode >/dev/null 2>&1; then qrencode -t ansiutf8 "$url"; fi
			exit 0
		fi
		running || break
		sleep 1
	done
	printf '%s\n' "$out" >&2
	echo "t3-devpod: could not pair; see $LOG_FILE" >&2
	exit 1
	;;
stop)
	if running; then kill "$(cat "$PID_FILE")"; fi
	rm -f "$PID_FILE"
	tailscale serve --https="$SERVE_PORT" off >/dev/null 2>&1 ||
		sudo -n tailscale serve --https="$SERVE_PORT" off >/dev/null 2>&1 || true
	;;
status)
	if running; then
		echo "running (pid $(cat "$PID_FILE")), tailnet https port $SERVE_PORT, log $LOG_FILE"
	else
		echo "not running"
		exit 1
	fi
	;;
*)
	echo "usage: t3-devpod [start|pair|stop|status]" >&2
	exit 2
	;;
esac
