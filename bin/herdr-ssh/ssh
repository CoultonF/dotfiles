#!/bin/bash
# Herdr-only SSH shim; all other destinations keep their original arguments.
args=("$@")
filtered=()
i=0
count=${#args[@]}

while (( i < count )); do
	arg=${args[i]}
	if [[ $arg == -- ]]; then
		filtered+=("$arg")
		i=$((i + 1))
		break
	fi
	if [[ $arg != -* || $arg == - ]]; then
		break
	fi

	# A value-taking flag consumes the rest of its cluster, or the next argv.
	rest=${arg:1}
	prefix=-
	while [[ -n $rest ]]; do
		flag=${rest:0:1}
		rest=${rest:1}
		case $flag in
		4|6|A|a|C|f|G|g|K|k|M|N|n|q|s|T|t|V|v|X|x|Y|y)
			prefix+=$flag
			;;
		B|b|c|D|E|e|F|I|i|J|L|l|m|O|o|P|p|Q|R|S|W|w)
			separate=0
			value=$rest
			if [[ -z $rest ]]; then
				if (( i + 1 >= count )); then
					exec /usr/bin/ssh "$@"
				fi
				separate=1
				value=${args[i + 1]}
			fi
			remove=0
			if [[ $flag == o ]]; then
				shopt -s nocasematch
				[[ $value =~ ^[[:space:]]*StrictHostKeyChecking[[:space:]=] ]] && remove=1
				shopt -u nocasematch
			fi
			if (( remove )); then
				# Keep any flags preceding -o in the same cluster.
				if [[ $prefix != - ]]; then
					filtered+=("$prefix")
				fi
			else
				filtered+=("$arg")
				if (( separate )); then
					filtered+=("$value")
				fi
			fi
			i=$((i + separate))
			prefix=-
			rest=
			;;
		*)
			# Unknown flags make the destination uncertain: do not rewrite.
			exec /usr/bin/ssh "$@"
			;;
		esac
	done
	if [[ $prefix != - ]]; then
		filtered+=("$arg")
	fi
	i=$((i + 1))
done

# Stop at the destination: remote command arguments are never interpreted.
if (( i < count )) && [[ ${args[i]} == rcom.devpod ]]; then
	exec /usr/bin/ssh "${filtered[@]}" "${args[@]:i}"
fi
exec /usr/bin/ssh "$@"
