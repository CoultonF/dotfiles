#!/usr/bin/env bash
# t3-devpod: run a T3 Code server inside a devpod, published on the tailnet.
#
#   t3-devpod start   Start `t3 serve` behind Tailscale Serve if it isn't running.
#                     Silent no-op off Linux or without a connected tailscaled,
#                     so shell startup can call it unconditionally.
#   t3-devpod pair    Start if needed, then mint a pairing link (prints the
#                     t3code:// app link). The Mac's `t3-pair` runs this over SSH.
#   t3-devpod stop    Stop the server.
#   t3-devpod status  Show whether the server is running and where.
#
# Tailscale Serve uses HTTPS port $T3_DEVPOD_SERVE_PORT (default 8443), leaving
# 443 for project services that already claim it.
set -euo pipefail

SERVE_PORT="${T3_DEVPOD_SERVE_PORT:-8443}"
STATE_DIR="$HOME/.t3/devpod"
PID_FILE="$STATE_DIR/serve.pid"
LOG_FILE="$STATE_DIR/serve.log"
export PATH="$HOME/.bun/bin:$HOME/.nix-profile/bin:/nix/var/nix/profiles/default/bin:$PATH"

# The pid file survives a devpod restart, so check the pid still belongs to t3.
running() {
	local pid
	pid="$(cat "$PID_FILE" 2>/dev/null)" || return 1
	[ -n "$pid" ] && kill -0 "$pid" 2>/dev/null &&
		tr '\0' ' ' <"/proc/$pid/cmdline" 2>/dev/null | grep -q 't3'
}

tailnet_up() {
	command -v tailscale >/dev/null 2>&1 &&
		tailscale status --json 2>/dev/null | grep -q '"BackendState": *"Running"'
}

# rcom-style devpods run tailscaled as root without an operator, so the login
# user can't configure Serve until it is made the operator.
ensure_serve_permission() {
	tailscale serve status >/dev/null 2>&1 && return 0
	sudo -n tailscale set --operator="$USER" >/dev/null 2>&1
}

start() {
	[ "$(uname -s)" = Linux ] || return 0
	running && return 0
	command -v t3 >/dev/null 2>&1 || return 0
	tailnet_up || return 0
	ensure_serve_permission || {
		echo "t3-devpod: cannot configure Tailscale Serve (no operator rights, no passwordless sudo)" >&2
		return 1
	}

	local workdir="${T3_DEVPOD_CWD:-}"
	if [ -z "$workdir" ]; then
		if [ -d /workspace ]; then workdir=/workspace; else workdir="$HOME"; fi
	fi

	mkdir -p "$STATE_DIR"
	setsid nohup t3 serve --no-browser \
		--tailscale-serve --tailscale-serve-port "$SERVE_PORT" \
		--auto-bootstrap-project-from-cwd "$workdir" \
		>>"$LOG_FILE" 2>&1 </dev/null &
	echo $! >"$PID_FILE"
}

case "${1:-start}" in
start)
	start
	;;
pair)
	tailnet_up || { echo "t3-devpod: tailscale is not connected on $(hostname)" >&2; exit 1; }
	start
	# `t3 pair` fails with NoRunningServerError until the server has written
	# its runtime file, so retry while a fresh server boots.
	for _ in $(seq 1 60); do
		if out="$(t3 pair --tailscale --tailscale-serve-port "$SERVE_PORT" --label "${2:-$(hostname)}" 2>&1)"; then
			printf '%s\n' "$out"
			exit 0
		fi
		running || break
		sleep 1
	done
	printf '%s\n' "$out" >&2
	echo "t3-devpod: could not pair; see $LOG_FILE" >&2
	exit 1
	;;
stop)
	if running; then kill "$(cat "$PID_FILE")"; fi
	rm -f "$PID_FILE"
	;;
status)
	if running; then
		echo "running (pid $(cat "$PID_FILE")), tailnet https port $SERVE_PORT, log $LOG_FILE"
	else
		echo "not running"
		exit 1
	fi
	;;
*)
	echo "usage: t3-devpod [start|pair|stop|status]" >&2
	exit 2
	;;
esac
