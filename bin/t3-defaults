#!/usr/bin/env bash
# t3-defaults: seed T3 Code's provider setup into its settings.json.
#
# Turns on Linked environments (so this node can be linked from another T3),
# adds the Claude, Antigravity (agy) and Codex providers, and favorites the Codex models
# OMP's modelRoles use in omp/agent/config.yml, in
# $T3CODE_HOME/userdata/settings.json (default ~/.t3). Only keys the file lacks
# are filled in, and the old OMP provider is removed.
# Run before T3 starts: `t3-devpod start` calls it on devpods and home-manager
# activation calls it on macOS.
set -euo pipefail

home="${T3CODE_HOME:-$HOME/.t3}"
settings="$home/userdata/settings.json"

defaults='{
  "linkedEnvironmentsEnabled": true,
  "providerInstances": {
    "claudeAgent": { "driver": "claudeAgent", "enabled": true },
    "antigravity": { "driver": "antigravity", "displayName": "Antigravity", "enabled": true },
    "codex": { "driver": "codex", "enabled": true }
  },
  "favorites": [
    { "provider": "codex", "model": "gpt-6.2-astra" },
    { "provider": "codex", "model": "gpt-6.2-sol" },
    { "provider": "codex", "model": "gpt-6-luna" }
  ]
}'

command -v jq >/dev/null 2>&1 || { echo "t3-defaults: jq not found" >&2; exit 1; }

# Use the native launchers when installed. Their updaters keep these paths stable.
if [ -x "$HOME/.local/bin/claude" ]; then
	defaults="$(jq '.providerInstances.claudeAgent.config.binaryPath = "~/.local/bin/claude"' <<<"$defaults")"
fi
if [ -x "$HOME/.local/bin/agy" ]; then
	defaults="$(jq '.providerInstances.antigravity.config.binaryPath = "~/.local/bin/agy"' <<<"$defaults")"
fi

current='{}'
if [ -s "$settings" ]; then
	current="$(cat "$settings")"
	# Leave a file T3 itself can't parse alone rather than replace it.
	jq -e 'type == "object"' >/dev/null 2>&1 <<<"$current" || {
		echo "t3-defaults: $settings is not a JSON object; leaving it unchanged" >&2
		exit 1
	}
fi

# `*` merges objects recursively with the right side winning: existing settings.
merged="$(jq --argjson d "$defaults" '$d * . | del(.providerInstances.omp)' <<<"$current")"
[ "$(jq -S . <<<"$merged")" = "$(jq -S . <<<"$current")" ] && exit 0

mkdir -p "$(dirname "$settings")"
tmp="$(mktemp "$settings.XXXXXX")"
printf '%s\n' "$merged" >"$tmp"
mv "$tmp" "$settings"
echo "t3-defaults: updated providers and favorites in $settings"
