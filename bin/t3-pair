#!/usr/bin/env bash
# t3-pair: add a devpod to the T3 Code desktop app.
#
#   t3-pair <workspace>    e.g. t3-pair rcom-aws2
#
# Runs `t3-devpod pair` in the workspace over DevPod's SSH alias, which starts
# the workspace's T3 server on the tailnet if needed, then opens the printed
# t3code:// link so the desktop app asks to confirm the new environment.
# Pairing is one-time per workspace name: T3's data lives on the /workspace
# volume, so it survives rebuilds. Pair a phone by scanning the QR code that
# `ssh <ws>.devpod t3-devpod pair` prints.
set -euo pipefail

if [ $# -ne 1 ]; then
	echo "usage: t3-pair <devpod-workspace>" >&2
	devpod list 2>/dev/null || true
	exit 2
fi

workspace="${1%.devpod}"
host="$workspace.devpod"

# shellcheck disable=SC2029 # $workspace is meant to expand locally
out="$(ssh "$host" "\$HOME/.dotfiles/bin/t3-devpod pair $workspace")"
link="$(printf '%s\n' "$out" | sed -n 's/^App link: *\(t3code:\/\/[^[:space:]]*\).*/\1/p' | head -1)"

if [ -z "$link" ]; then
	printf '%s\n' "$out" >&2
	echo "t3-pair: no app link in the output from $host" >&2
	exit 1
fi

printf '%s\n' "$out" | grep -E '^(Pairing with|Pairing URL|Expires)' || true
open "$link"
